# Admin authentication
ADMIN_EMAIL=admin@vinipainting.com
ADMIN_PASSWORD=use-a-strong-admin-password
ADMIN_ROLE=ADMIN
ADMIN_SESSION_SECRET=use-a-long-random-session-secret

# Leads notification (optional)
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=

# Database (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
ALLOW_FILE_LEAD_STORAGE_FALLBACK=true

# Gallery uploads (Cloudflare R2 primary, MinIO fallback)
CF_R2_ENDPOINT=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=
CF_R2_PUBLIC_BASE_URL=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PUBLIC_BASE_URL=

GALLERY_UPLOAD_MAX_FILES=20
GALLERY_UPLOAD_MAX_FILE_SIZE_MB=10
